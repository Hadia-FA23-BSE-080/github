# ============================================
# SUPABASE — Get these from supabase.com/dashboard
# Settings → API (URL + Keys)
# Settings → Database → Connection string
# ============================================
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Supabase PostgreSQL (Settings → Database → Connection string → URI)
# Use the "Transaction" connection pooler for DATABASE_URL
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use the "Session" connection pooler for DIRECT_URL (for migrations)
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ============================================
# STRIPE (optional — app uses mock payments without these)
# ============================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
